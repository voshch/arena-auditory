<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arena_auditory_viz</name>
  <version>0.0.0</version>
  <description>RViz plugins of the auditory stack: the auditory panel and the spawn sound and spawn microphone tools.</description>
  <maintainer email="dev@voshch.dev">voshch</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>pluginlib</depend>
  <depend>rviz_common</depend>
  <depend>rviz_default_plugins</depend>
  <depend>geometry_msgs</depend>
  <depend>arena_auditory_msgs</depend>
  <depend>task_generator_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
